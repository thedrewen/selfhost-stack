          },
          "expr": "sum(inari_channel_clients_total{target=~\"$target\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Channels created (period)",
