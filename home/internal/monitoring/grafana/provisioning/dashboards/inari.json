      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(inari_channels_created_total{target=~\"$target\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Channels deleted (period)",
      "description": "Channels that disappeared during the selected time range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
