# Public domain of Inari (must point to the server)
INARI_DOMAIN="inari.thedrewen.com"
# Key used by the game connector to authenticate (e.g. `openssl rand -hex 16`)
INARI_API_KEY=""
# Public IP of the server (NOT the domain), announced to WebRTC clients
INARI_SERVER_PUBLIC_IP=""
# Maximum distance at which players hear each other
INARI_MAX_DISTANCE=20
# Channel used when a player does not specify one
INARI_DEFAULT_CHANNEL="default"
# Default audio transport: udp or tcp
INARI_PROTOCOL_MODE="udp"
# true disables anonymous telemetry
INARI_DISABLE_TELEMETRY=false
